{
  "schema_version": "1.0",
  "environment": "preactivation",
  "data_policy": "PUBLIC_OR_SYNTHETIC_ONLY",
  "bindings": [
    {
      "id": "site",
      "capability": "SITE_HEALTH_CHECK",
      "enabled": false,
      "target": null,
      "activation_requires": [
        "production_domain",
        "approved_site_deploy"
      ]
    },
    {
      "id": "booking",
      "capability": "BOOKING_LINK_CHECK",
      "enabled": false,
      "target": null,
      "activation_requires": [
        "approved_clinical_booking_url",
        "active_clinician_route"
      ]
    },
    {
      "id": "profile",
      "capability": "PROFILE_LINK_CHECK",
      "enabled": false,
      "target": null,
      "activation_requires": [
        "approved_public_profile_url"
      ]
    },
    {
      "id": "email_dns",
      "capability": "EMAIL_DNS_AUDIT",
      "enabled": false,
      "target": "lifelatelycounseling.com",
      "activation_requires": [
        "workspace_tenant",
        "approved_dns_expectations"
      ]
    },
    {
      "id": "tls",
      "capability": "TLS_HEALTH_CHECK",
      "enabled": false,
      "target": null,
      "activation_requires": [
        "production_domain"
      ]
    },
    {
      "id": "domain",
      "capability": "DOMAIN_EXPIRY_CHECK",
      "enabled": false,
      "target": "lifelatelycounseling.com",
      "activation_requires": [
        "registrar_account_confirmed"
      ]
    }
  ]
}
